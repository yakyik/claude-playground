# ─── Bastion MCP Server — Environment Variables ─────────────────────────────
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Required: You must set either BASTION_JWT_SECRET or BASTION_API_KEY.
# The server will refuse to start without authentication configured.

# ─── Authentication (pick one) ───────────────────────────────────────────────

# Option 1 (recommended): JWT-based auth with tool-scoped claims
# Generate a strong secret: openssl rand -hex 32
BASTION_JWT_SECRET=
BASTION_JWT_ISSUER=bastion-mcp-server

# Option 2: Simple shared API key (all callers get same permissions)
# Generate a key: openssl rand -hex 32
# BASTION_API_KEY=

# ─── Tailscale ───────────────────────────────────────────────────────────────

# Auth key for the Tailscale sidecar container. Get one from:
# https://login.tailscale.com/admin/settings/keys
# Use a reusable, ephemeral key tagged with 'tag:bastion'
TS_AUTHKEY=

# ─── Server ──────────────────────────────────────────────────────────────────

# Domain name for the bastion (used by Caddy for TLS certificates)
BASTION_DOMAIN=bastion.yourcompany.com

# HTTP port for the MCP server (Caddy proxies to this)
PORT=3001

# Transport mode: 'http' (default, production) or 'stdio' (local dev)
TRANSPORT=http

# Log level: 'debug', 'info' (default), 'warn', 'error'
LOG_LEVEL=info

# ─── Service Registry ───────────────────────────────────────────────────────

# Path to the JSON config file with backend service definitions.
# See config/services.example.json for the format.
BASTION_CONFIG_PATH=/app/config/services.json

# Alternative: define services inline as a JSON array (overrides config file)
# BASTION_SERVICES='[{"name":"users","url":"http://users-api.tail1234.ts.net:8080"}]'
